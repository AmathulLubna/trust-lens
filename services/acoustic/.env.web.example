# Website-only service; never copy the Android/backend .env.
# Supply a NEW server-only token, matching ACOUSTIC_SERVICE_TOKEN in your WEBSITE Convex deployment.
TRUSTLENS_WEB_SERVICE_TOKEN=
TRUSTLENS_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5175
# Optional controlled-call demo, disabled by default. Separately provision personal credentials as SHA256 hashes.
TRUSTLENS_WEB_LIVE_DEMO=false
TRUSTLENS_WEB_USER_TOKEN_HASHES={}
TRUSTLENS_WEB_DEMO_VERIFIERS=
TRUSTLENS_WEB_WHISPER_MODEL_SIZE=tiny
# Optional relay infrastructure; shared secret stays server-side.
TRUSTLENS_WEB_ICE_URLS=[]
TRUSTLENS_WEB_TURN_SECRET=

# Optional bounded warmup of the independent model worker; disabled for core-only UI setup.
TRUSTLENS_WEB_WARMUP=false
