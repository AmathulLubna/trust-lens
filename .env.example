# Browser configuration. Copy to a new .env.local only if one does not exist.
VITE_CONVEX_URL=
# HTTP actions URL of the SAME Convex deployment, e.g. https://<deployment>.convex.site
VITE_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# The following are SERVER environment variables (Convex dashboard/CLI), never VITE_*.
# Comma-separated allowed website origins (include your actual development origin).
# WEB_ORIGINS=http://localhost:5173
# Python service reachable FROM Convex; HTTPS except local integration tests.
# ACOUSTIC_SERVICE_URL=
# ACOUSTIC_SERVICE_TOKEN=
# Existing email OTP integration requires an operator-supplied Freebuff credential.
# FREEBUFF_EMAIL_API_KEY=
# VLY_APP_NAME=TrustLens
# Configure Convex Auth's SITE_URL, JWT_PRIVATE_KEY, JWKS through its setup workflow.

# Optional warning emails. Keep disabled until verified-recipient testing is authorized.
# ALERT_DELIVERY_ENABLED=false
# RESEND_API_KEY=
# RESEND_FROM=
# RESEND_WEBHOOK_SECRET=

# Optional controlled-call demo: independent WEBSITE acoustic service only.
VITE_LIVE_ANALYSIS_ORIGIN=http://127.0.0.1:8876
# Configure WEBSITE Convex separately; never reuse app backend credentials or endpoint.
