# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Backend HTTP action origin for auth, e.g. https://your-deployment.convex.site.
# SITE_URL is the frontend origin; configure both in the Convex environment.
CONVEX_SITE_URL=
SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Optional AI providers for scam checks. Gemini is tried first for message/image
# checks when configured; Groq remains supported as fallback and for voice.
GEMINI_API_KEY=
GROQ_API_KEY=

# Backend environment only. Obtain a fresh OTP key from your email provider.
OTP_EMAIL_API_KEY=
RESEND_API_KEY=
# Verified Resend sender, e.g. Trust Lens <alerts@example.com>
RESEND_FROM_EMAIL=
